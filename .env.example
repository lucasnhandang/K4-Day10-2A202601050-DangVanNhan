LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
# Optional reproducibility controls. Leave false to reuse existing artifacts.
REFRESH_SOURCE=false
REFRESH_TEST_SET=false
# Optional slower Ragas evaluation; requires a configured LLM provider.
RUN_RAGAS=true
# Optional separate judge model (empty = use answer model for judging).
JUDGE_LLM_PROVIDER=
JUDGE_LLM_MODEL=
JUDGE_API_KEY=
